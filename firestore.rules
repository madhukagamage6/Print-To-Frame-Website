rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All access goes through the submitLead Cloud Function (Admin SDK),
    // which bypasses these rules. No client ever reads or writes Firestore
    // directly, so lock it down completely.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
